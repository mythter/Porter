<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:model="using:Porter.Models"
			 xmlns:vm="using:Porter.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="40"
			 x:DataType="model:SshServer"
			 x:Class="Porter.Controls.SshServerControl"
			 Classes="deletable">

	<Grid ColumnDefinitions="0.8*, 5, 0.6*, 5, *, 5, 100"
		  MinHeight="20">
		<TextBox Grid.Column="0"
				 Watermark="Name"
				 Text="{Binding Name}"
				 ToolTip.Tip="{Binding Name, TargetNullValue=SSH Server Name}"
				 KeyDown="OnKeyDown"
				 VerticalContentAlignment="Center"/>

		<TextBox Grid.Column="2"
				 Watermark="User"
				 Text="{Binding User}"
				 ToolTip.Tip="{Binding User, TargetNullValue=SSH Server User Name}"
				 KeyDown="OnKeyDown"
				 VerticalContentAlignment="Center"/>

		<TextBox Grid.Column="4"
				 Watermark="Host"
				 Text="{Binding Host}"
				 ToolTip.Tip="{Binding Host, TargetNullValue=SSH Server Host}"
				 KeyDown="OnKeyDown"
				 VerticalContentAlignment="Center"/>


		<Grid Grid.Column="6"
			  ColumnDefinitions="*, 5, Auto">
			<NumericUpDown Grid.Column="0"
						   Watermark="Port"
						   ToolTip.Tip="SSH Server Port"
						   VerticalContentAlignment="Center"
						   MinWidth="0"
						   Maximum="65535"
						   Minimum="0"
						   FormatString="0"
						   ShowButtonSpinner="False"
						   KeyDown="OnKeyDown"
						   Value="{Binding Port}" />

			<Button Grid.Column="2"
					x:Name="DeleteButton"
					ToolTip.Tip="Delete SSH Server"
					Command="{Binding $parent[ItemsControl].((vm:SshServersPageViewModel)DataContext).DeleteCommand}"
					CommandParameter="{Binding}"
					Classes="no-padding content-center"
					VerticalAlignment="Stretch"
					Height="{ Binding $parent.Bounds.Height }">

				<TextBlock
					Text="&#xE4A6;"
					FontSize="24"
					FontFamily="{ StaticResource Phosphor }"/>
			</Button>
		</Grid>

	</Grid>
	
</UserControl>
