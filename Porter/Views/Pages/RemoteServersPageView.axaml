<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:Porter.ViewModels.Pages"
			 xmlns:c="clr-namespace:Porter.Views.Controls"
			 xmlns:b="using:Porter.Behaviors"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="vm:RemoteServersPageViewModel"
			 x:Class="Porter.Views.RemoteServersPageView">
	
	<Grid RowDefinitions="Auto,10,*">
		<Grid Grid.Row="0"
			  ColumnDefinitions="Auto,*,Auto"
			  Height="30">
			<Button Grid.Column="0"
					Classes="no-padding content-center"
					Command="{Binding GoToTunnelsCommand}"
					Height="{Binding $parent.Height }"
					Width="{Binding $self.Height}">
				<TextBlock
					Text="&#xE138;"
					FontSize="20"
					FontFamily="{ StaticResource Phosphor }"/>
			</Button>
			<TextBlock Grid.Column="1"
					   Text="Remote Servers"
					   VerticalAlignment="Center"
					   HorizontalAlignment="Center"
					   FontSize="16"/>
			<Button Grid.Column="2"
					Classes="no-padding content-center"
					ToolTip.Tip="Add new Remote Server"
					Command="{Binding AddRemoteServer}"
					Height="{Binding $parent.Height }"
					Width="{Binding $self.Height}">
				<TextBlock
					Text="&#xE3D4;"
					FontSize="20"
					FontFamily="{ StaticResource Phosphor }"/>
			</Button>
		</Grid>

		<ScrollViewer Grid.Row="2">
			<ItemsControl ItemsSource="{Binding Items}"
						  b:DragReorderBehavior.Enabled="True">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Spacing="5" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<c:RemoteServerControl Padding="5"
											Background="{DynamicResource SecondaryBackground}"
											CornerRadius="5">

						</c:RemoteServerControl>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

	</Grid>
</UserControl>
