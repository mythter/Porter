<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:model="using:Porter.Models"
			 xmlns:vm="using:Porter.ViewModels.Pages"
			 xmlns:b="using:Porter.Behaviors"
			 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="40"
			 x:DataType="model:PrivateKey"
			 x:Class="Porter.Views.Controls.PrivateKeyControl"
			 Classes="deletable">

	<Grid ColumnDefinitions="0.5*, 5, *"
		  MinHeight="20">
		<TextBox Grid.Column="0"
				 PlaceholderText="Name"
				 Text="{Binding Name}"
				 ToolTip.Tip="{Binding Name, TargetNullValue=Private Key Name}"
				 KeyDown="OnKeyDown"
				 VerticalContentAlignment="Center">

		</TextBox>

		<Grid Grid.Column="2"
			  ColumnDefinitions="*, 5, Auto">
			<TextBlock Grid.Column="0"
					   VerticalAlignment="Center"
					   HorizontalAlignment="Center"
					   Cursor="Hand"
					   TextDecorations="Underline"
					   Text="{Binding FilePath}"
					   ToolTip.Tip="{Binding FilePath}"
					   TextTrimming="{x:Static TextTrimming.LeadingCharacterEllipsis}"
					   b:PointerPressedCommandBehavior.Command="{Binding $parent[ItemsControl].((vm:PrivateKeysPageViewModel)DataContext).OpenPrivateKeyFileCommand}"
					   b:PointerPressedCommandBehavior.CommandParameter="{Binding}" />

			<Button Grid.Column="2"
					x:Name="DeleteButton"
					ToolTip.Tip="Delete Private Key"
					Command="{Binding $parent[ItemsControl].((vm:PrivateKeysPageViewModel)DataContext).DeleteCommand}"
					CommandParameter="{Binding}"
					Classes="no-padding content-center"
					VerticalAlignment="Stretch"
					Height="{ Binding $parent.Bounds.Height }">

				<TextBlock
				Text="&#xE4A6;"
				FontSize="24"
				FontFamily="{ StaticResource Phosphor }"/>
			</Button>
		</Grid>
	</Grid>

</UserControl>
