<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:c="using:Porter.Controls">
	<Design.PreviewWith>
		<Border Padding="20" Height="200">

			<Button Grid.Column="4"
					Classes="no-padding content-center stretch"
					FontSize="12">
				Stop All
			</Button>

		</Border>
	</Design.PreviewWith>

	<Style Selector="Button#DeleteButton">
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Opacity" Value="0"/>
		<Setter Property="Width" Value="0"/>
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Opacity" Duration="0:0:0.1" Easing="QuadraticEaseInOut"/>
				<DoubleTransition Property="Width" Duration="0:0:0.1" Easing="QuadraticEaseInOut"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector=".deletable:pointerover Button#DeleteButton">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="Width" Value="{ Binding $self.Height }"/>
	</Style>

	<Style Selector="Button.tunnel-started">
		<Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}"/>
	</Style>
	<Style Selector="Button.tunnel-started:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundCheckedPointerOver}"/>
	</Style>
</Styles>
